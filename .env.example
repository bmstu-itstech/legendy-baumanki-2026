# Скопируйте в .env и заполните перед `docker compose up`.
# Локально дефолты ниже уже рабочие — можно просто скопировать как есть.
# В проде обязательно смените POSTGRES_PASSWORD/SECRET_KEY и поменяйте
# DOMAIN/CORS_ORIGINS/NEXT_PUBLIC_API_URL на реальные адреса.

# --- Postgres ---
POSTGRES_DB=legendy_baumanki
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Backend ---
# Длинная случайная строка, напр.: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
DOMAIN=localhost
# Через запятую, без пробелов вокруг запятой не обязательно.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Адрес backend API, доступный из БРАУЗЕРА пользователя (не из контейнера
# frontend) — вшивается в клиентский JS-бандл при сборке.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
